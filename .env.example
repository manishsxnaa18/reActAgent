# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Vector Store Provider (Required for RAG)
# Options: pinecone | qdrant
VECTOR_STORE_PROVIDER=pinecone

# Pinecone API Key (Required if VECTOR_STORE_PROVIDER=pinecone)
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=pcsk-your-pinecone-api-key-here
PINECONE_INDEX_NAME=company-knowledge

# Qdrant (Required if VECTOR_STORE_PROVIDER=qdrant)
# Local default: http://localhost:6333
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=company-knowledge

# Tavily API Key (Required for web search)
# Get from: https://tavily.com/api/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Google Calendar (Optional)
# Get from: https://console.cloud.google.com/
GOOGLE_ACCESS_TOKEN=ya29.your-access-token-here
GOOGLE_REFRESH_TOKEN=1//your-refresh-token-here

# Calendar re-auth UX
# cli: show OAuth URL and expect calendar_auth <code>
# app: show generic message (for end-user apps)
CALENDAR_REAUTH_MODE=cli

# Gmail Sender (Optional - required for messaging)
GMAIL_SENDER_ADDRESS=you@company.com

# Model Selection (Optional)
# Default: gpt-5-mini
# Options: gpt-5-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
DEFAULT_MODEL=gpt-5-mini

# Translation (Optional)
# Set ENABLE_TRANSLATION=true to translate non-English user input to English
# and translate responses back to the user's language.
ENABLE_TRANSLATION=true
TRANSLATION_MODEL=gpt-4o-mini

# Agent identity (Optional)
# Give your assistant a friendly name. Default: Meera
AGENT_NAME=Meera

# MongoDB Contacts (Optional)
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=reactAgent
MONGODB_CONTACTS_COLLECTION=contacts

# Slack messaging (Optional)
# Requires chat:write, conversations:read, conversations.write, users:read.email scopes
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Twilio WhatsApp (Optional)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_WHATSAPP_NUMBER=+12345550000

# Jira Cloud (Optional)
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=OPS
JIRA_PROJECT_KEYS=OPS,ENG
JIRA_BOARD_ID=123
