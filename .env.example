# OpenAI API Key (Required)
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone API Key (Required for RAG)
# Get from: https://www.pinecone.io/
PINECONE_API_KEY=pcsk-your-pinecone-api-key-here

# Tavily API Key (Required for web search)
# Get from: https://tavily.com/api/
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Google Calendar (Optional)
# Get from: https://console.cloud.google.com/
GOOGLE_ACCESS_TOKEN=ya29.your-access-token-here
GOOGLE_REFRESH_TOKEN=1//your-refresh-token-here

# Model Selection (Optional)
# Default: gpt-5-mini
# Options: gpt-5-mini, gpt-4o, gpt-4-turbo, gpt-3.5-turbo
DEFAULT_MODEL=gpt-5-mini

# Agent identity (Optional)
# Give your assistant a friendly name. Default: Meera
AGENT_NAME=Meera
